# Copy this file to .env and replace every required blank value.
MYSQL_DATABASE=micro_approval_db
MYSQL_USER=micro_approval
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3306

JWT_SECRET=
AI_CREDENTIAL_ENCRYPTION_KEY=

FRONTEND_PORT=3000
# Keep these exact origins in sync when FRONTEND_PORT changes.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_ANALYSIS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.5-flash

RULE_ENGINE_MAX_CARDS_PER_SESSION=10
AI_ANALYSIS_MAX_CARDS_PER_SESSION=10
WORKSPACE_INVITATION_EXPIRATION_DAYS=7
